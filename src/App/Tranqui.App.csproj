<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <!-- Android 10 (API 29) is the minimum for CallScreeningService with RoleManager. -->
    <SupportedOSPlatformVersion>29.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>Tranqui.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <!-- Generated MAUI/XAML code does not follow the repository's documentation rules. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <ApplicationTitle>Tranqui</ApplicationTitle>
    <ApplicationId>com.fsoftt.tranqui</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <!--
    Environment settings, injected at build time (dotnet build -p:TranquiApiBaseUrl=... -p:TranquiFirebaseApiKey=...)
    or from the untracked Tranqui.App.local.props. Debug defaults to the API on the emulator's host machine.
  -->
  <Import Project="Tranqui.App.local.props" Condition="Exists('Tranqui.App.local.props')" />
  <PropertyGroup>
    <TranquiApiBaseUrl Condition="'$(TranquiApiBaseUrl)' == '' and '$(Configuration)' == 'Debug'">http://10.0.2.2:5254/</TranquiApiBaseUrl>
    <TranquiApiBaseUrl Condition="'$(TranquiApiBaseUrl)' == ''">https://api.example.invalid/</TranquiApiBaseUrl>
    <TranquiFirebaseApiKey Condition="'$(TranquiFirebaseApiKey)' == ''">not-configured</TranquiFirebaseApiKey>
    <TranquiCloudProjectNumber Condition="'$(TranquiCloudProjectNumber)' == ''">0</TranquiCloudProjectNumber>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="TranquiApiBaseUrl" Value="$(TranquiApiBaseUrl)" />
    <AssemblyMetadata Include="TranquiFirebaseApiKey" Value="$(TranquiFirebaseApiKey)" />
    <AssemblyMetadata Include="TranquiCloudProjectNumber" Value="$(TranquiCloudProjectNumber)" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0F4C81" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F4C81" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Xamarin.Google.Android.Play.Integrity" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\App.Core\Tranqui.App.Core.csproj" />
  </ItemGroup>

</Project>
