<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:Tranqui.App.Core.Resources;assembly=Tranqui.App.Core"
             xmlns:vm="clr-namespace:Tranqui.App.Core.ViewModels;assembly=Tranqui.App.Core"
             xmlns:appearance="clr-namespace:Tranqui.App.Core.Appearance;assembly=Tranqui.App.Core"
             x:Class="Tranqui.App.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{x:Static res:Texts.TabSettings}">

  <ScrollView>
    <VerticalStackLayout Style="{StaticResource Form}">
      <Label Text="{x:Static res:Texts.AutoBlockHeading}" Style="{StaticResource Headline}" SemanticProperties.HeadingLevel="Level1" />
      <Label Text="{x:Static res:Texts.AutoBlockIntro}" />

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <VerticalStackLayout>
          <Label Text="{x:Static res:Texts.BlockSpamTitle}" FontAttributes="Bold" />
          <Label Text="{x:Static res:Texts.BlockSpamDetail}" FontSize="14" />
        </VerticalStackLayout>
        <Switch Grid.Column="1" IsToggled="{Binding BlockCommunitySpam}" AutomationId="BlockCommunitySpamSwitch"
                SemanticProperties.Description="{x:Static res:Texts.BlockSpamTitle}" />
      </Grid>

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <VerticalStackLayout>
          <Label Text="{x:Static res:Texts.BlockPrivateTitle}" FontAttributes="Bold" />
          <Label Text="{x:Static res:Texts.BlockPrivateDetail}" FontSize="14" />
        </VerticalStackLayout>
        <Switch Grid.Column="1" IsToggled="{Binding BlockPrivateNumbers}" AutomationId="BlockPrivateNumbersSwitch"
                SemanticProperties.Description="{x:Static res:Texts.BlockPrivateTitle}" />
      </Grid>

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <VerticalStackLayout>
          <Label Text="{x:Static res:Texts.BlockInternationalTitle}" FontAttributes="Bold" />
          <Label Text="{x:Static res:Texts.BlockInternationalDetail}" FontSize="14" />
        </VerticalStackLayout>
        <Switch Grid.Column="1" IsToggled="{Binding BlockInternational}" AutomationId="BlockInternationalSwitch"
                SemanticProperties.Description="{x:Static res:Texts.BlockInternationalTitle}" />
      </Grid>

      <Label Text="{x:Static res:Texts.PrefixesHeading}" FontAttributes="Bold" Margin="0,8,0,0" SemanticProperties.HeadingLevel="Level2" />
      <Label Text="{x:Static res:Texts.PrefixesHint}" FontSize="14" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <Entry Text="{Binding NewPrefix}"
               Placeholder="{x:Static res:Texts.PrefixPlaceholder}"
               Keyboard="Telephone"
               AutomationId="NewPrefixEntry"
               SemanticProperties.Description="{x:Static res:Texts.PrefixesHeading}" />
        <Button Grid.Column="1" Text="{x:Static res:Texts.AddPrefix}" Command="{Binding AddPrefixCommand}" AutomationId="AddPrefixButton" />
      </Grid>
      <VerticalStackLayout BindableLayout.ItemsSource="{Binding BlockedPrefixes}" Spacing="4">
        <BindableLayout.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <Label Text="{Binding .}" FontSize="18" VerticalOptions="Center" />
              <Button Grid.Column="1"
                      Text="{x:Static res:Texts.RemovePrefix}"
                      Style="{StaticResource SecondaryButton}"
                      Command="{Binding RemovePrefixCommand, Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, x:DataType=vm:SettingsViewModel}"
                      CommandParameter="{Binding .}"
                      SemanticProperties.Hint="{Binding .}" />
            </Grid>
          </DataTemplate>
        </BindableLayout.ItemTemplate>
      </VerticalStackLayout>

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,8,0,0">
        <VerticalStackLayout>
          <Label Text="{x:Static res:Texts.ShareBlocksTitle}" FontAttributes="Bold" />
          <Label Text="{x:Static res:Texts.ShareBlocksDetail}" FontSize="14" />
        </VerticalStackLayout>
        <Switch Grid.Column="1" IsToggled="{Binding ShareBlocks}" AutomationId="ShareBlocksSwitch"
                SemanticProperties.Description="{x:Static res:Texts.ShareBlocksTitle}" />
      </Grid>

      <Label Text="{x:Static res:Texts.ThemeHeading}" Style="{StaticResource Headline}" SemanticProperties.HeadingLevel="Level2" Margin="0,16,0,0" />
      <Picker ItemsSource="{Binding ThemeOptions}"
              SelectedItem="{Binding SelectedTheme}"
              ItemDisplayBinding="{Binding Label, x:DataType=appearance:ThemeOption}"
              AutomationId="ThemePicker"
              SemanticProperties.Description="{x:Static res:Texts.ThemeHeading}" />

      <Label Text="{x:Static res:Texts.ContributeHeading}" Style="{StaticResource Headline}" SemanticProperties.HeadingLevel="Level2" Margin="0,16,0,0" />
      <Label Text="{x:Static res:Texts.ContributionExplanation}" FontSize="14" />

      <Label Text="{Binding ErrorMessage}"
             Style="{StaticResource ErrorMessage}"
             IsVisible="{Binding ErrorMessage, Converter={StaticResource HasText}}" />
      <Label Text="{Binding InfoMessage}"
             Style="{StaticResource InfoMessage}"
             IsVisible="{Binding InfoMessage, Converter={StaticResource HasText}}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

      <Button Text="{x:Static res:Texts.StartContributing}"
              Command="{Binding StartContributingCommand}"
              IsVisible="{Binding IsNotContributing}"
              IsEnabled="{Binding IsNotBusy}"
              AutomationId="StartContributingButton" />
      <Button Text="{x:Static res:Texts.StopContributing}"
              Style="{StaticResource SecondaryButton}"
              Command="{Binding StopContributingCommand}"
              IsVisible="{Binding IsContributing}"
              IsEnabled="{Binding IsNotBusy}"
              AutomationId="StopContributingButton" />
    </VerticalStackLayout>
  </ScrollView>

</ContentPage>
