<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:Tranqui.App.Core.Resources;assembly=Tranqui.App.Core"
             xmlns:vm="clr-namespace:Tranqui.App.Core.ViewModels;assembly=Tranqui.App.Core"
             xmlns:protection="clr-namespace:Tranqui.App.Core.Protection;assembly=Tranqui.App.Core"
             x:Class="Tranqui.App.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="Tranqui">

  <ScrollView>
    <VerticalStackLayout Style="{StaticResource Form}">
      <Image Source="shield.png" HeightRequest="72" WidthRequest="72" SemanticProperties.Description="Tranqui" />
      <Label Text="{Binding StatusTitle}"
             Style="{StaticResource Headline}"
             SemanticProperties.HeadingLevel="Level1"
             AutomationId="ProtectionStatus" />

      <Border Padding="16" StrokeShape="RoundRectangle 12" IsVisible="{Binding ShowBlockSharingNotice}" AutomationId="BlockSharingNotice">
        <VerticalStackLayout Spacing="8">
          <Label Text="{x:Static res:Texts.BlockSharingNoticeTitle}" FontAttributes="Bold" FontSize="16" SemanticProperties.HeadingLevel="Level2" />
          <Label Text="{x:Static res:Texts.BlockSharingNoticeText}" FontSize="14" />
          <FlexLayout Wrap="Wrap">
            <Button Text="{x:Static res:Texts.Understood}" Command="{Binding DismissBlockSharingNoticeCommand}" Margin="0,0,8,8" />
            <Button Text="{x:Static res:Texts.ChangeInSettings}"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding OpenSettingsCommand}"
                    Margin="0,0,8,8" />
          </FlexLayout>
        </VerticalStackLayout>
      </Border>

      <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Steps}">
        <BindableLayout.ItemTemplate>
          <DataTemplate x:DataType="protection:ProtectionStep">
            <Border Padding="16" StrokeShape="RoundRectangle 12">
              <VerticalStackLayout Spacing="8">
                <HorizontalStackLayout Spacing="8">
                  <Label Text="✓"
                         TextColor="{StaticResource StateKnownContact}"
                         FontSize="18"
                         IsVisible="{Binding IsDone}"
                         SemanticProperties.Description="{x:Static res:Texts.Done}" />
                  <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="{Binding Explanation}" FontSize="14" />
                <Button Text="{x:Static res:Texts.Enable}"
                        Command="{Binding EnableCommand}"
                        IsVisible="{Binding IsPending}"
                        SemanticProperties.Hint="{Binding Title}" />
              </VerticalStackLayout>
            </Border>
          </DataTemplate>
        </BindableLayout.ItemTemplate>
      </VerticalStackLayout>
    </VerticalStackLayout>
  </ScrollView>

</ContentPage>
