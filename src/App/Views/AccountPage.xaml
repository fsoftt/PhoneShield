<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tranqui.App.Core.ViewModels;assembly=Tranqui.App.Core"
             x:Class="Tranqui.App.Views.AccountPage"
             x:DataType="vm:AccountViewModel"
             Title="Cuenta">

  <ScrollView>
    <VerticalStackLayout Style="{StaticResource Form}">
      <Label Text="Tu cuenta" Style="{StaticResource Headline}" SemanticProperties.HeadingLevel="Level1" />
      <Label Text="{Binding Email}" FontSize="16" />

      <Label Text="Tu número de teléfono no está vinculado a tu cuenta. Los números que aportas se guardan solo como un código cifrado (hash)."
             FontSize="14" />

      <Button Text="Ver qué datos guardamos" Style="{StaticResource SecondaryButton}" Command="{Binding ShowMyDataCommand}" />
      <Label Text="{Binding MyDataSummary}" IsVisible="{Binding MyDataSummary, Converter={StaticResource HasText}}" />

      <Label Text="{Binding ErrorMessage}"
             Style="{StaticResource ErrorMessage}"
             IsVisible="{Binding ErrorMessage, Converter={StaticResource HasText}}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

      <Button Text="Cerrar sesión" Style="{StaticResource SecondaryButton}" Command="{Binding SignOutCommand}" />
      <Button Text="Borrar mi cuenta"
              BackgroundColor="{StaticResource StateSpam}"
              TextColor="White"
              Command="{Binding DeleteAccountCommand}"
              IsEnabled="{Binding IsNotBusy}"
              AutomationId="DeleteAccountButton" />
    </VerticalStackLayout>
  </ScrollView>

</ContentPage>
