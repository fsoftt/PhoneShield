<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:Tranqui.App.Core.Resources;assembly=Tranqui.App.Core"
             xmlns:vm="clr-namespace:Tranqui.App.Core.ViewModels;assembly=Tranqui.App.Core"
             x:Class="Tranqui.App.Views.AccountPage"
             x:DataType="vm:AccountViewModel"
             Title="{x:Static res:Texts.TabAccount}">

  <ScrollView>
    <VerticalStackLayout Style="{StaticResource Form}">
      <Label Text="{x:Static res:Texts.AccountHeading}" Style="{StaticResource Headline}" SemanticProperties.HeadingLevel="Level1" />
      <Label Text="{Binding Email}" FontSize="16" />

      <Label Text="{x:Static res:Texts.AccountPrivacyNote}"
             FontSize="14" />

      <Button Text="{x:Static res:Texts.ShowMyData}" Style="{StaticResource SecondaryButton}" Command="{Binding ShowMyDataCommand}" />
      <Label Text="{Binding MyDataSummary}" IsVisible="{Binding MyDataSummary, Converter={StaticResource HasText}}" />

      <Label Text="{Binding ErrorMessage}"
             Style="{StaticResource ErrorMessage}"
             IsVisible="{Binding ErrorMessage, Converter={StaticResource HasText}}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

      <Button Text="{x:Static res:Texts.AppealOpen}"
              Style="{StaticResource SecondaryButton}"
              Command="{Binding OpenAppealCommand}"
              AutomationId="OpenAppealButton" />
      <Button Text="{x:Static res:Texts.SignOut}" Style="{StaticResource SecondaryButton}" Command="{Binding SignOutCommand}" />
      <Button Text="{x:Static res:Texts.DeleteMyAccount}"
              BackgroundColor="{StaticResource StateSpam}"
              TextColor="White"
              Command="{Binding DeleteAccountCommand}"
              IsEnabled="{Binding IsNotBusy}"
              AutomationId="DeleteAccountButton" />
    </VerticalStackLayout>
  </ScrollView>

</ContentPage>
