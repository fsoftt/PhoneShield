<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tranqui.App.Core.ViewModels;assembly=Tranqui.App.Core"
             x:Class="Tranqui.App.Views.VerifyEmailPage"
             x:DataType="vm:VerifyEmailViewModel"
             Shell.NavBarIsVisible="False">

  <ScrollView>
    <VerticalStackLayout Style="{StaticResource Form}">
      <Label Text="Verifica tu correo" Style="{StaticResource Headline}" SemanticProperties.HeadingLevel="Level1" />
      <Label Style="{StaticResource SubHeadline}">
        <Label.FormattedText>
          <FormattedString>
            <Span Text="Te enviamos un enlace a " />
            <Span Text="{Binding Email}" FontAttributes="Bold" />
            <Span Text=". Ábrelo y vuelve aquí." />
          </FormattedString>
        </Label.FormattedText>
      </Label>

      <Label Text="{Binding ErrorMessage}"
             Style="{StaticResource ErrorMessage}"
             IsVisible="{Binding ErrorMessage, Converter={StaticResource HasText}}" />
      <Label Text="{Binding InfoMessage}"
             Style="{StaticResource InfoMessage}"
             IsVisible="{Binding InfoMessage, Converter={StaticResource HasText}}" />

      <Button Text="Ya lo verifiqué"
              Command="{Binding CheckCommand}"
              IsEnabled="{Binding IsNotBusy}"
              AutomationId="VerifyEmailCheckButton" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
      <Button Text="Reenviar el correo"
              Style="{StaticResource SecondaryButton}"
              Command="{Binding ResendCommand}"
              IsEnabled="{Binding IsNotBusy}" />
      <Button Text="Usar otra cuenta"
              Style="{StaticResource LinkButton}"
              Command="{Binding UseAnotherAccountCommand}" />
    </VerticalStackLayout>
  </ScrollView>

</ContentPage>
