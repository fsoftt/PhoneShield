<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:Tranqui.App.Core.Resources;assembly=Tranqui.App.Core"
             xmlns:vm="clr-namespace:Tranqui.App.Core.ViewModels;assembly=Tranqui.App.Core"
             x:Class="Tranqui.App.Views.SignInPage"
             x:DataType="vm:SignInViewModel"
             Shell.NavBarIsVisible="False">

  <ScrollView>
    <VerticalStackLayout Style="{StaticResource Form}">
      <Image Source="shield.png" HeightRequest="72" WidthRequest="72" SemanticProperties.Description="Tranqui" />
      <Label Text="Tranqui" Style="{StaticResource Headline}" SemanticProperties.HeadingLevel="Level1" />
      <Label Text="{x:Static res:Texts.AppTagline}"
             Style="{StaticResource SubHeadline}" />

      <Entry Text="{Binding Email}"
             Placeholder="{x:Static res:Texts.EmailPlaceholder}"
             Keyboard="Email"
             IsSpellCheckEnabled="False"
             AutomationId="SignInEmail"
             SemanticProperties.Description="{x:Static res:Texts.EmailDescription}" />
      <Entry Text="{Binding Password}"
             Placeholder="{x:Static res:Texts.PasswordPlaceholder}"
             IsPassword="True"
             AutomationId="SignInPassword"
             SemanticProperties.Description="{x:Static res:Texts.PasswordPlaceholder}" />

      <Label Text="{Binding ErrorMessage}"
             Style="{StaticResource ErrorMessage}"
             IsVisible="{Binding ErrorMessage, Converter={StaticResource HasText}}" />
      <Label Text="{Binding InfoMessage}"
             Style="{StaticResource InfoMessage}"
             IsVisible="{Binding InfoMessage, Converter={StaticResource HasText}}" />

      <Button Text="{x:Static res:Texts.SignInButton}"
              Command="{Binding SignInCommand}"
              IsEnabled="{Binding IsNotBusy}"
              AutomationId="SignInButton" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
      <Button Text="{x:Static res:Texts.ForgotPassword}"
              Style="{StaticResource LinkButton}"
              Command="{Binding ForgotPasswordCommand}"
              IsEnabled="{Binding IsNotBusy}" />
      <Button Text="{x:Static res:Texts.CreateAccountLink}"
              Style="{StaticResource SecondaryButton}"
              Command="{Binding GoToSignUpCommand}"
              AutomationId="GoToSignUpButton" />
    </VerticalStackLayout>
  </ScrollView>

</ContentPage>
