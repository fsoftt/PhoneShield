<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tranqui.App.Core.ViewModels;assembly=Tranqui.App.Core"
             xmlns:history="clr-namespace:Tranqui.App.Core.History;assembly=Tranqui.App.Core"
             x:Class="Tranqui.App.Views.CallHistoryPage"
             x:DataType="vm:CallHistoryViewModel"
             Title="Historial">

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="24" RowSpacing="12">
    <Label Text="Llamadas recientes" Style="{StaticResource Headline}" SemanticProperties.HeadingLevel="Level1" />
    <Label Grid.Row="1" Text="Se guardan solo en este teléfono durante 30 días." FontSize="14" />
    <VerticalStackLayout Grid.Row="2">
      <Label Text="{Binding ErrorMessage}"
             Style="{StaticResource ErrorMessage}"
             IsVisible="{Binding ErrorMessage, Converter={StaticResource HasText}}" />
      <Label Text="{Binding InfoMessage}"
             Style="{StaticResource InfoMessage}"
             IsVisible="{Binding InfoMessage, Converter={StaticResource HasText}}" />
    </VerticalStackLayout>

    <CollectionView Grid.Row="3" ItemsSource="{Binding Entries}" AutomationId="CallHistoryList">
      <CollectionView.EmptyView>
        <Label Text="Aún no hay llamadas revisadas por Tranqui." HorizontalOptions="Center" Margin="0,32" />
      </CollectionView.EmptyView>
      <CollectionView.ItemTemplate>
        <DataTemplate x:DataType="history:CallHistoryEntry">
          <Border Padding="16" Margin="0,0,0,12" StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="6">
              <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="17" />
              <Label Text="{Binding Summary}" FontSize="14" />
              <Label Text="{Binding When}" FontSize="13" />
              <HorizontalStackLayout Spacing="8" IsVisible="{Binding CanReport}">
                <Button Text="Es spam"
                        Command="{Binding ReportSpamCommand, Source={RelativeSource AncestorType={x:Type vm:CallHistoryViewModel}}, x:DataType=vm:CallHistoryViewModel}"
                        CommandParameter="{Binding .}" />
                <Button Text="No es spam"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ReportNotSpamCommand, Source={RelativeSource AncestorType={x:Type vm:CallHistoryViewModel}}, x:DataType=vm:CallHistoryViewModel}"
                        CommandParameter="{Binding .}" />
                <Button Text="Bloquear"
                        Style="{StaticResource LinkButton}"
                        Command="{Binding BlockCommand, Source={RelativeSource AncestorType={x:Type vm:CallHistoryViewModel}}, x:DataType=vm:CallHistoryViewModel}"
                        CommandParameter="{Binding .}" />
              </HorizontalStackLayout>
            </VerticalStackLayout>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>

    <Button Grid.Row="4" Text="Borrar historial" Style="{StaticResource LinkButton}" Command="{Binding ClearCommand}" />
  </Grid>

</ContentPage>
