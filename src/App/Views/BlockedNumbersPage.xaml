<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tranqui.App.Core.ViewModels;assembly=Tranqui.App.Core"
             xmlns:numbers="clr-namespace:Tranqui.Domain.PhoneNumbers;assembly=Tranqui.Domain"
             x:Class="Tranqui.App.Views.BlockedNumbersPage"
             x:DataType="vm:BlockedNumbersViewModel"
             Title="Bloqueados">

  <Grid RowDefinitions="Auto,*" Padding="24" RowSpacing="16">
    <Label Text="Números bloqueados" Style="{StaticResource Headline}" SemanticProperties.HeadingLevel="Level1" />

    <CollectionView Grid.Row="1" ItemsSource="{Binding Numbers}" AutomationId="BlockedNumbersList">
      <CollectionView.EmptyView>
        <Label Text="No has bloqueado ningún número." HorizontalOptions="Center" Margin="0,32" />
      </CollectionView.EmptyView>
      <CollectionView.ItemTemplate>
        <DataTemplate x:DataType="numbers:PhoneNumber">
          <Grid ColumnDefinitions="*,Auto" Padding="0,8">
            <Label Text="{Binding E164}" FontSize="18" VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="Desbloquear"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding UnblockCommand, Source={RelativeSource AncestorType={x:Type vm:BlockedNumbersViewModel}}, x:DataType=vm:BlockedNumbersViewModel}"
                    CommandParameter="{Binding .}"
                    SemanticProperties.Hint="{Binding E164}" />
          </Grid>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
  </Grid>

</ContentPage>
