<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tranqui.App.Core.ViewModels;assembly=Tranqui.App.Core"
             x:Class="Tranqui.App.Views.SignUpPage"
             x:DataType="vm:SignUpViewModel"
             Title="Crear cuenta">

  <ScrollView>
    <VerticalStackLayout Style="{StaticResource Form}">
      <Label Text="Crea tu cuenta" Style="{StaticResource Headline}" SemanticProperties.HeadingLevel="Level1" />
      <Label Text="Tu número de teléfono no se vincula a tu cuenta."
             Style="{StaticResource SubHeadline}" />

      <Entry Text="{Binding Email}"
             Placeholder="Correo"
             Keyboard="Email"
             IsSpellCheckEnabled="False"
             AutomationId="SignUpEmail"
             SemanticProperties.Description="Correo electrónico" />
      <Entry Text="{Binding Password}"
             Placeholder="Contraseña (mínimo 8 caracteres)"
             IsPassword="True"
             AutomationId="SignUpPassword"
             SemanticProperties.Description="Contraseña, mínimo 8 caracteres" />
      <Entry Text="{Binding ConfirmPassword}"
             Placeholder="Repite la contraseña"
             IsPassword="True"
             AutomationId="SignUpConfirmPassword"
             SemanticProperties.Description="Repite la contraseña" />

      <HorizontalStackLayout Spacing="8">
        <CheckBox IsChecked="{Binding AcceptedTerms}"
                  AutomationId="SignUpAcceptTerms"
                  SemanticProperties.Description="Acepto los términos y la política de tratamiento de datos" />
        <Label Text="Acepto los términos y la política de tratamiento de datos."
               VerticalOptions="Center"
               LineBreakMode="WordWrap"
               MaximumWidthRequest="360" />
      </HorizontalStackLayout>

      <Label Text="{Binding ErrorMessage}"
             Style="{StaticResource ErrorMessage}"
             IsVisible="{Binding ErrorMessage, Converter={StaticResource HasText}}" />

      <Button Text="Crear cuenta"
              Command="{Binding SignUpCommand}"
              IsEnabled="{Binding IsNotBusy}"
              AutomationId="SignUpButton" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
    </VerticalStackLayout>
  </ScrollView>

</ContentPage>
