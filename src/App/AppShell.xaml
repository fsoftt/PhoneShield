<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="Tranqui.App.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Tranqui.App.Views"
       Title="Tranqui"
       Shell.FlyoutBehavior="Disabled">

  <ShellContent Route="startup" ContentTemplate="{DataTemplate views:StartupPage}" />
  <ShellContent Route="sign-in" ContentTemplate="{DataTemplate views:SignInPage}" />
  <ShellContent Route="verify-email" ContentTemplate="{DataTemplate views:VerifyEmailPage}" />
  <ShellContent Route="home" Title="Inicio" ContentTemplate="{DataTemplate views:HomePage}" />

</Shell>
