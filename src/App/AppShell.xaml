<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="Tranqui.App.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:res="clr-namespace:Tranqui.App.Core.Resources;assembly=Tranqui.App.Core"
       xmlns:views="clr-namespace:Tranqui.App.Views"
       Title="Tranqui"
       Shell.FlyoutBehavior="Disabled">

  <ShellContent Route="startup" ContentTemplate="{DataTemplate views:StartupPage}" />
  <ShellContent Route="sign-in" ContentTemplate="{DataTemplate views:SignInPage}" />
  <ShellContent Route="verify-email" ContentTemplate="{DataTemplate views:VerifyEmailPage}" />
  <TabBar Route="main">
    <ShellContent Route="home" Title="{x:Static res:Texts.TabHome}" ContentTemplate="{DataTemplate views:HomePage}" />
    <ShellContent Route="history" Title="{x:Static res:Texts.TabHistory}" ContentTemplate="{DataTemplate views:CallHistoryPage}" />
    <ShellContent Route="blocked" Title="{x:Static res:Texts.TabBlocked}" ContentTemplate="{DataTemplate views:BlockedNumbersPage}" />
    <ShellContent Route="settings" Title="{x:Static res:Texts.TabSettings}" ContentTemplate="{DataTemplate views:SettingsPage}" />
    <ShellContent Route="account" Title="{x:Static res:Texts.TabAccount}" ContentTemplate="{DataTemplate views:AccountPage}" />
  </TabBar>

</Shell>
