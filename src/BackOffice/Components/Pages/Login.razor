@page "/login"
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using Tranqui.BackOffice.Authentication
@inject AdminSignIn SignIn
@inject NavigationManager Navigation

<PageTitle>@T["SignInTitle"] · Tranqui</PageTitle>

<EditForm Model="Input" FormName="login" OnValidSubmit="SignInAsync" class="card narrow">
    <DataAnnotationsValidator />
    <h1>@T["SignInTitle"]</h1>

    @if (Problem is not null)
    {
        <p class="notice problem" role="alert">@Problem</p>
    }

    <label>
        <span>@T["Email"]</span>
        <InputText @bind-Value="Input!.Email" type="email" autocomplete="username" required />
    </label>
    <label>
        <span>@T["Password"]</span>
        <InputText @bind-Value="Input!.Password" type="password" autocomplete="current-password" required />
    </label>
    <button type="submit">@T["SignIn"]</button>
</EditForm>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private LoginInput? Input { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? Problem { get; set; }

    protected override void OnInitialized() => Input ??= new();

    private async Task SignInAsync()
    {
        var outcome = await SignIn.SignInAsync(HttpContext, Input!.Email, Input.Password);
        if (outcome == SignInOutcome.SignedIn)
        {
            // Only local paths: an open redirect would let a phishing link bounce through the back office.
            Navigation.NavigateTo(ReturnUrl is { } url && url.StartsWith('/') && !url.StartsWith("//", StringComparison.Ordinal)
                ? url
                : BackOfficeRoutes.Home);
            return;
        }

        Problem = outcome switch
        {
            SignInOutcome.WrongCredentials => T["WrongCredentials"],
            SignInOutcome.NotAnAdmin => T["Forbidden"],
            _ => T["Error"],
        };
    }

    private sealed class LoginInput
    {
        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }
}
