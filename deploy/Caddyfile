# Caddy obtains and renews the TLS certificate for the domain automatically.
{$TRANQUI_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Access logs would record client IPs and paths; numbers never travel in paths, but keep logs off anyway.
	reverse_proxy api:8080
}
