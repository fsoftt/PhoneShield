# Copy to deploy/.env on the server (never commit it). Generate each key with: openssl rand -base64 32
TRANQUI_DOMAIN=api.example.com
FIREBASE_PROJECT_ID=your-firebase-project-id
POSTGRES_PASSWORD=
PHONE_HASHING_CURRENT_KEY_VERSION=1
PHONE_HASHING_KEY_1=
NAME_PROTECTION_KEY=
CONTRIBUTOR_IDS_KEY=
# Base64 of the JSON key of the Google Cloud service account that decodes Play Integrity tokens (appeals). Optional.
PLAY_INTEGRITY_SERVICE_ACCOUNT_KEY=
